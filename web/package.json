{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:e2e": "tsc -b && vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-ts",
    "i18n:extract": "formatjs extract \"src/**/*.{ts,tsx}\" --ignore \"src/**/*.d.ts\" --ignore \"src/api/generated/**\" --format simple --out-file src/i18n/messages/en.json --throws",
    "i18n:pseudo": "formatjs compile src/i18n/messages/en.json --format simple --ast --pseudo-locale xx-LS --out-file src/i18n/messages/xx-LS.json && formatjs compile src/i18n/messages/en.json --format simple --ast --pseudo-locale en-XA --out-file src/i18n/messages/en-XA.json && formatjs compile src/i18n/messages/en.json --format simple --ast --pseudo-locale en-XB --out-file src/i18n/messages/en-XB.json",
    "i18n:verify": "formatjs verify --source-locale en --missing-keys --structural-equality src/i18n/messages/en.json src/i18n/messages/ar.json",
    "i18n": "pnpm i18n:extract && pnpm i18n:pseudo && pnpm i18n:verify",
    "e2e": "playwright test --project=smoke",
    "e2e:full": "playwright test --project=full --project=pseudo",
    "e2e:visual": "playwright test --project=visual",
    "lhci": "lhci autorun",
    "e2e:visual:update": "docker run --rm --add-host=host.docker.internal:host-gateway -v \"$PWD:/web\" -e E2E_BASE_URL mcr.microsoft.com/playwright:v1.64.0-noble sh /web/e2e/update-visual-baselines.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-intl": "12.1.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.16.34",
    "@hey-api/openapi-ts": "0.99.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.2",
    "@tanstack/router-plugin": "1.168.45",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-formatjs": "8.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
