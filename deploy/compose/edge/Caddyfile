# TLS edge (ADR-0015). Each environment's web container joins the memo-edge network with the alias <project>-web.
{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

(common) {
	# Files (ADR-0029): streamed, never compressed (ranges and binary content), body limit = the platform upload ceiling.
	@files path /api/v1/files /api/v1/files/*
	@other not path /api/v1/files /api/v1/files/*
	encode @other zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	request_body @other {
		max_size 1MB
	}
	request_body @files {
		max_size 100MB
	}
}

{$MEMO_DEV_HOST} {
	import common
	reverse_proxy memo-dev-web:8080
}

{$MEMO_STAGING_HOST} {
	import common
	reverse_proxy memo-staging-web:8080
}
