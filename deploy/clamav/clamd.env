# clamd settings for every install (ADR-0029), applied by the official image's /init as CLAMD_CONF_<Option> lines in
# /etc/clamav/clamd.conf. Used by Compose (env_file), Helm (values) and the tests (TestMalwareScanner).
# Heuristic alerts are off by default in ClamAV; a file the engine cannot fully scan must be reported, not passed.
CLAMD_CONF_AlertExceedsMax=yes
CLAMD_CONF_AlertEncrypted=yes
CLAMD_CONF_AlertOLE2Macros=yes
CLAMD_CONF_AlertBrokenExecutables=yes
# Above the platform upload ceiling (memo.files.max-upload-bytes, 100 MiB), so an allowed upload is always scanned whole.
CLAMD_CONF_StreamMaxLength=110M
CLAMD_CONF_MaxFileSize=110M
CLAMD_CONF_MaxScanSize=400M
CLAMD_CONF_MaxRecursion=10
CLAMD_CONF_MaxFiles=10000
CLAMD_CONF_MaxScanTime=120000
