# On-prem / VM environment file. Copy to .env, then run deploy/scripts/gen-secrets.sh .env to fill every secret.
# Never commit .env. Secrets below are intentionally empty.

COMPOSE_PROJECT_NAME=memo

# --- Images: pin by digest (the release notes list them; verify with `cosign verify --key cosign.pub ...`) ---
MEMO_BACKEND_IMAGE=ghcr.io/nazihar/memo-backend@sha256:REPLACE
MEMO_WEB_IMAGE=ghcr.io/nazihar/memo-web@sha256:REPLACE
MEMO_POSTGRES_IMAGE=postgres:18.6
MEMO_SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.48
MEMO_AWSCLI_IMAGE=amazon/aws-cli:2.37.13

# --- Network ---
# Address/port the web service publishes on the host (keep 127.0.0.1 behind a reverse proxy / the edge profile).
MEMO_WEB_BIND=127.0.0.1
MEMO_WEB_PORT=8080
MEMO_EDGE_NETWORK=memo-edge

# --- Organisations (ADR-0022) ---
# multi: each organisation on <slug>.<base domain>; single: one organisation for every host (dedicated installs).
MEMO_TENANCY_MODE=multi
MEMO_TENANCY_BASE_DOMAIN=memo.example.com
MEMO_TENANCY_SINGLE_TENANT=
# Organisation for the bare base domain (dev/staging only).
MEMO_TENANCY_FALLBACK_TENANT=
# Links in emails; {slug} is the organisation. Empty: https://{slug}.<base domain>.
MEMO_PUBLIC_URL_TEMPLATE=

# --- Optional integrations (leave empty to disable; the health page then shows "Not configured") ---
MEMO_SMTP_HOST=
MEMO_SMTP_PORT=25
MEMO_SMTP_FROM=
MEMO_SMTP_USERNAME=
MEMO_SMTP_PASSWORD=
# STARTTLS is required unless switched off for a mail catcher on the same host.
MEMO_SMTP_STARTTLS=true
# With --profile documents:
MEMO_DOCSERVER_URL=
# With --profile antivirus:
MEMO_CLAMAV_HOST=

# --- Behaviour ---
MEMO_SPRING_PROFILES=prod
MEMO_DEMO_SEED=false
MEMO_OTEL_EXPORT=false

# --- Secrets (generated by deploy/scripts/gen-secrets.sh) ---
POSTGRES_SUPERUSER_PASSWORD=
MEMO_MIGRATOR_PASSWORD=
MEMO_APP_PASSWORD=
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
S3_APP_ACCESS_KEY=
S3_APP_SECRET_KEY=
ONLYOFFICE_JWT_SECRET=
# Demo users only (MEMO_DEMO_SEED=true, never under the prod profile).
MEMO_DEMO_PASSWORD=
MEMO_DEMO_TOTP_SECRET=
# Key material for secrets encrypted at rest (TOTP secrets). Back it up with the database: without it, users re-enrol MFA.
MEMO_DATA_KEY=
