# SPA + API reverse proxy (ADR-0012). Rendered by the nginx entrypoint (envsubst of ${BACKEND_URL}, ${OFFICE_URL} and
# ${NGINX_RESOLVER} only).
# Note: add_header directives are NOT inherited into a location that declares its own add_header, so every location
# that serves SPA content includes the security-header snippet itself. /api/ responses keep the backend's own headers.
# WebSocket upgrade for the document editor (/office/).
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size 1m;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The backend trusts forwarded headers from private-range proxies (Tomcat RemoteIpValve, ADR-0025): never pass
        # client-supplied host or port through, or a request could pick another tenant's host (ADR-0022).
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 60s;
    }

    # Files (ADR-0029): streamed both ways. Request buffering would write uploads to a temp file before the backend
    # scans and encrypts them, response buffering would write decrypted downloads to one: both are off. The body limit
    # is the platform ceiling (memo.files.max-upload-bytes); the backend enforces each purpose's own limit.
    location /api/v1/files {
        client_max_body_size 100m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_max_temp_file_size 0;
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # The document server (ADR-0037) under /office/ on the tenant's own host, so the SPA's CSP stays 'self'. Resolved per
    # request: installs without ONLYOFFICE start fine and answer 502 here. X-Forwarded-Host carries the sub-path, which
    # is how ONLYOFFICE learns its public base URL. Its pages are framed by the SPA, whose documents require COEP, so
    # they get the matching cross-origin headers; our CSP is not applied to them (the editor is not our code).
    location /office/ {
        resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
        set $office ${OFFICE_URL};
        rewrite ^/office/(.*)$ /$1 break;
        proxy_pass $office;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host/office;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 100m;
        proxy_read_timeout 3600s;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Content-hashed build assets: cache forever.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Everything else is the SPA shell (client-side routes); never cached so a deploy is picked up immediately.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        # no-store alone already forbids caching; the rest is what ZAP rule 10015 looks for, so the rule stays useful.
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri /index.html;
    }
}
