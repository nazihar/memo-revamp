{
  "components" : {
    "schemas" : {
      "ChangePasswordRequest" : {
        "properties" : {
          "currentPassword" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : "string"
          },
          "newPassword" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : "string"
          }
        },
        "required" : [ "currentPassword", "newPassword" ],
        "type" : "object"
      },
      "CodeRequest" : {
        "properties" : {
          "code" : {
            "description" : "6-digit TOTP code, or a recovery code",
            "maxLength" : 32,
            "type" : "string"
          }
        },
        "required" : [ "code" ],
        "type" : "object"
      },
      "ComponentHealth" : {
        "properties" : {
          "name" : {
            "type" : "string"
          },
          "status" : {
            "enum" : [ "UP", "DOWN", "DISABLED" ],
            "type" : "string"
          }
        },
        "required" : [ "name", "status" ],
        "type" : "object"
      },
      "Health" : {
        "description" : "Public platform status. Contains only component names and states.",
        "properties" : {
          "checkedAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "components" : {
            "items" : {
              "$ref" : "#/components/schemas/ComponentHealth"
            },
            "type" : "array"
          },
          "status" : {
            "enum" : [ "UP", "DEGRADED", "DOWN" ],
            "type" : "string"
          }
        },
        "required" : [ "checkedAt", "components", "status" ],
        "type" : "object"
      },
      "Invitation" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "description" : "Masked, for example n***@bank.example",
            "type" : "string"
          },
          "organisation" : {
            "type" : "string"
          }
        },
        "required" : [ "displayName", "email", "organisation" ],
        "type" : "object"
      },
      "InvitationAcceptance" : {
        "properties" : {
          "password" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : "string"
          },
          "token" : {
            "maxLength" : 100,
            "type" : "string"
          }
        },
        "required" : [ "password", "token" ],
        "type" : "object"
      },
      "InvitationLookup" : {
        "properties" : {
          "token" : {
            "description" : "From the emailed link (its fragment)",
            "maxLength" : 100,
            "type" : "string"
          }
        },
        "required" : [ "token" ],
        "type" : "object"
      },
      "LoginRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 320,
            "type" : "string"
          },
          "password" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ],
        "type" : "object"
      },
      "Me" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "lastLoginAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "mfaEnrolled" : {
            "type" : "boolean"
          },
          "tenantAdmin" : {
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "email", "id", "mfaEnrolled", "tenantAdmin" ],
        "type" : "object"
      },
      "MfaEnrolment" : {
        "description" : "Shown once while enrolling; the secret never appears again.",
        "properties" : {
          "otpauthUri" : {
            "type" : "string"
          },
          "qrSvg" : {
            "description" : "QR code of otpauthUri as SVG markup",
            "type" : "string"
          },
          "secret" : {
            "description" : "Base32 secret for manual entry",
            "type" : "string"
          }
        },
        "required" : [ "otpauthUri", "qrSvg", "secret" ],
        "type" : "object"
      },
      "MfaEnrolmentConfirmed" : {
        "properties" : {
          "recoveryCodes" : {
            "description" : "Shown once; each code works once",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "session" : {
            "$ref" : "#/components/schemas/Session"
          }
        },
        "required" : [ "recoveryCodes", "session" ],
        "type" : "object"
      },
      "MySession" : {
        "properties" : {
          "current" : {
            "type" : "boolean"
          },
          "id" : {
            "description" : "Opaque handle (never the session id)",
            "type" : "string"
          },
          "ipAddress" : {
            "type" : [ "string", "null" ]
          },
          "lastActiveAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "signedInAt" : {
            "format" : "date-time",
            "type" : [ "string", "null" ]
          },
          "userAgent" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "current", "id", "lastActiveAt" ],
        "type" : "object"
      },
      "PasswordResetCompletion" : {
        "properties" : {
          "newPassword" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : "string"
          },
          "token" : {
            "description" : "From the emailed link (its fragment)",
            "maxLength" : 100,
            "type" : "string"
          }
        },
        "required" : [ "newPassword", "token" ],
        "type" : "object"
      },
      "PasswordResetRequest" : {
        "properties" : {
          "email" : {
            "maxLength" : 320,
            "type" : "string"
          }
        },
        "required" : [ "email" ],
        "type" : "object"
      },
      "ProblemDetail" : {
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "format" : "uri",
            "type" : "string"
          },
          "properties" : {
            "additionalProperties" : { },
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "format" : "uri",
            "type" : "string"
          }
        },
        "type" : "object"
      },
      "RecoveryCodes" : {
        "properties" : {
          "recoveryCodes" : {
            "description" : "Shown once; the previous codes stop working",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          }
        },
        "required" : [ "recoveryCodes" ],
        "type" : "object"
      },
      "Session" : {
        "description" : "Who is signed in on this organisation's host, and what they must do next.",
        "properties" : {
          "organisation" : {
            "description" : "Display name of the organisation of this host",
            "type" : "string"
          },
          "state" : {
            "enum" : [ "ANONYMOUS", "MFA_REQUIRED", "MFA_ENROLMENT_REQUIRED", "AUTHENTICATED" ],
            "type" : "string"
          },
          "user" : {
            "description" : "Present unless ANONYMOUS",
            "oneOf" : [ {
              "$ref" : "#/components/schemas/SessionUser"
            }, {
              "type" : "null"
            } ]
          }
        },
        "required" : [ "organisation", "state" ],
        "type" : "object"
      },
      "SessionUser" : {
        "properties" : {
          "displayName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "tenantAdmin" : {
            "type" : "boolean"
          }
        },
        "required" : [ "displayName", "email", "id", "tenantAdmin" ],
        "type" : "object"
      },
      "StepUpRequest" : {
        "description" : "A TOTP or recovery code for users with MFA; the current password otherwise.",
        "properties" : {
          "code" : {
            "maxLength" : 32,
            "type" : [ "string", "null" ]
          },
          "password" : {
            "format" : "password",
            "maxLength" : 1024,
            "type" : [ "string", "null" ]
          }
        },
        "type" : "object"
      }
    }
  },
  "info" : {
    "description" : "REST API. Errors use RFC 9457 Problem Details (application/problem+json).",
    "license" : {
      "name" : "Proprietary"
    },
    "title" : "Memo & Meeting Management API",
    "version" : "v1"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/auth/csrf" : {
      "get" : {
        "description" : "Sets the XSRF-TOKEN cookie; send its value as X-XSRF-TOKEN on every mutating request. Call on start and after sign-in or sign-out.",
        "operationId" : "getCsrfToken",
        "responses" : {
          "204" : {
            "description" : "Cookie set"
          }
        },
        "summary" : "Issue the CSRF cookie",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/invitations/accept" : {
      "post" : {
        "description" : "Sets the password and signs in; the state says whether MFA enrolment follows.",
        "operationId" : "acceptInvitation",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/InvitationAcceptance"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "Signed in"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid or expired link, or a weak password"
          }
        },
        "summary" : "Accept an invitation",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/invitations/lookup" : {
      "post" : {
        "operationId" : "lookUpInvitation",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/InvitationLookup"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Invitation"
                }
              }
            },
            "description" : "Valid invitation"
          },
          "404" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Invitation"
                }
              }
            },
            "description" : "Unknown, used or expired link"
          }
        },
        "summary" : "Show an invitation",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/login" : {
      "post" : {
        "description" : "Starts a new session (new id). The state says whether a TOTP code or MFA enrolment follows.",
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "Signed in; see state"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid credentials (the same answer for unknown, inactive, locked and wrong-password cases)"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many attempts from this address or for this account; see Retry-After"
          }
        },
        "summary" : "Sign in with email and password",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/logout" : {
      "post" : {
        "description" : "Ends this session, complete or not.",
        "operationId" : "logout",
        "responses" : {
          "204" : {
            "description" : "Signed out"
          }
        },
        "summary" : "Sign out",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/mfa" : {
      "post" : {
        "description" : "A TOTP code (each usable once) or an unused recovery code. Rate-limited per user.",
        "operationId" : "verifyMfa",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CodeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "Factor added; see state"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid code"
          },
          "429" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Too many codes; see Retry-After"
          }
        },
        "summary" : "Second sign-in step",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/mfa/enrolment" : {
      "post" : {
        "description" : "During sign-in when enrolment is required, or from a complete session to switch devices. Confirm with a code to activate.",
        "operationId" : "startMfaEnrolment",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MfaEnrolment"
                }
              }
            },
            "description" : "Enrolment started"
          },
          "403" : {
            "description" : "Already enrolled and the session is not complete"
          }
        },
        "summary" : "Start TOTP enrolment",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/mfa/enrolment/confirm" : {
      "post" : {
        "description" : "Activates MFA, returns recovery codes once, and completes the sign-in step.",
        "operationId" : "confirmMfaEnrolment",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CodeRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MfaEnrolmentConfirmed"
                }
              }
            },
            "description" : "Enrolled"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid code"
          }
        },
        "summary" : "Confirm TOTP enrolment",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/password-reset" : {
      "post" : {
        "description" : "Always 202: the answer never says whether an account exists.",
        "operationId" : "requestPasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "If the account exists, a link is on its way"
          }
        },
        "summary" : "Email a password reset link",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/password-reset/complete" : {
      "post" : {
        "description" : "Signs out every session of the account. The link works once.",
        "operationId" : "completePasswordReset",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/PasswordResetCompletion"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Password set; sign in with it"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Invalid or expired link (errors[].field token), or a weak password (errors[].field newPassword)"
          }
        },
        "summary" : "Set a new password from a reset link",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/session" : {
      "get" : {
        "description" : "Never 401: anonymous callers get ANONYMOUS.",
        "operationId" : "getSession",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Session"
                }
              }
            },
            "description" : "Session state"
          }
        },
        "summary" : "Current session state",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/auth/step-up" : {
      "post" : {
        "description" : "Refreshes the session's strongest factor for the step-up window. Rate-limited per user.",
        "operationId" : "stepUp",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/StepUpRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Confirmed; retry the refused request"
          },
          "401" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Wrong code or password"
          }
        },
        "summary" : "Confirm it is you",
        "tags" : [ "auth" ]
      }
    },
    "/api/v1/health" : {
      "get" : {
        "description" : "Anonymous. Status per dependency, no versions, hosts or error details. Cached for a few seconds.",
        "operationId" : "getHealth",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            },
            "description" : "UP or DEGRADED"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            },
            "description" : "DOWN (the database is unreachable)"
          }
        },
        "summary" : "Platform status",
        "tags" : [ "system" ]
      }
    },
    "/api/v1/me" : {
      "get" : {
        "operationId" : "getMe",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Me"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "My account",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/password" : {
      "put" : {
        "description" : "Needs a recent step-up. Signs out every other session of the account.",
        "operationId" : "changeMyPassword",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Changed"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Current password wrong, or the new one breaks the policy (errors[].code: TOO_SHORT, TOO_LONG, BREACHED, CONTAINS_IDENTITY, INCORRECT)"
          }
        },
        "summary" : "Change my password",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/recovery-codes" : {
      "post" : {
        "description" : "Needs a recent step-up.",
        "operationId" : "regenerateMyRecoveryCodes",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RecoveryCodes"
                }
              }
            },
            "description" : "New codes"
          },
          "409" : {
            "description" : "MFA is not set up"
          }
        },
        "summary" : "New recovery codes",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/sessions" : {
      "get" : {
        "description" : "Every signed-in device of my account; the current one is marked.",
        "operationId" : "listMySessions",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "items" : {
                    "$ref" : "#/components/schemas/MySession"
                  },
                  "type" : "array"
                }
              }
            },
            "description" : "OK"
          }
        },
        "summary" : "My sessions",
        "tags" : [ "me" ]
      }
    },
    "/api/v1/me/sessions/{id}" : {
      "delete" : {
        "operationId" : "revokeMySession",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "Signed out"
          },
          "404" : {
            "description" : "No such session"
          }
        },
        "summary" : "Sign out one of my sessions",
        "tags" : [ "me" ]
      }
    }
  },
  "servers" : [ {
    "description" : "Same origin",
    "url" : "/"
  } ]
}
