{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memo.example/schemas/workflow-definition-v2.json",
  "title": "Workflow definition, schema version 2 (ADR-0038)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "start", "steps"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "attributes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
          "type": { "enum": ["string", "int", "double", "bool", "timestamp"] }
        }
      }
    },
    "resubmit": { "enum": ["restart", "resume", "skip-unchanged"] },
    "start": { "$ref": "#/$defs/stepId" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "stepId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "target": { "type": "string", "pattern": "^([a-z][a-z0-9-]{0,39})$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "action": { "enum": ["APPROVE", "RECOMMEND", "RETURN", "REJECT", "SEND_BACK", "FORWARD", "DELEGATE", "ASK", "REFER"] },
    "unitRef": {
      "anyOf": [{ "const": "initiator" }, { "type": "string", "format": "uuid" }]
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["person", "initiator", "position", "supervisor", "unitHead", "role", "queue"] },
        "userId": { "type": "string", "format": "uuid" },
        "positionId": { "type": "string", "format": "uuid" },
        "levels": { "type": "integer", "minimum": 1, "maximum": 10 },
        "unit": { "$ref": "#/$defs/unitRef" },
        "up": { "type": "integer", "minimum": 0, "maximum": 10 },
        "roleId": { "type": "string", "format": "uuid" },
        "queue": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,99}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "person" } } },
          "then": { "required": ["userId"], "propertyNames": { "enum": ["kind", "userId"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "initiator" } } },
          "then": { "propertyNames": { "enum": ["kind"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "position" } } },
          "then": { "required": ["positionId"], "propertyNames": { "enum": ["kind", "positionId"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "supervisor" } } },
          "then": { "required": ["levels"], "propertyNames": { "enum": ["kind", "levels"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "unitHead" } } },
          "then": { "required": ["unit"], "propertyNames": { "enum": ["kind", "unit", "up"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "role" } } },
          "then": { "required": ["roleId", "unit"], "propertyNames": { "enum": ["kind", "roleId", "unit"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "queue" } } },
          "then": { "required": ["queue"], "propertyNames": { "enum": ["kind", "queue"] } }
        }
      ]
    },
    "duration": { "type": "string", "pattern": "^P(?!$)(\\d{1,3}D)?(T(?=\\d)(\\d{1,4}H)?(\\d{1,4}M)?)?$" },
    "sla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["due"],
      "properties": {
        "due": { "$ref": "#/$defs/duration" },
        "workingTime": { "type": "boolean" },
        "remind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": { "$ref": "#/$defs/duration" },
            "after": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/duration" } }
          }
        },
        "escalate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["after", "action"],
          "properties": {
            "after": { "$ref": "#/$defs/duration" },
            "action": { "enum": ["notify", "reassign", "nextLevel"] },
            "to": { "$ref": "#/$defs/assignee" }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stepId" },
        "type": { "enum": ["route", "review", "approve", "parallel", "doa", "branch", "notify", "subworkflow", "escalate-to-forum", "sign"] },
        "name": { "$ref": "#/$defs/name" },
        "next": { "$ref": "#/$defs/target" },
        "assignee": { "$ref": "#/$defs/assignee" },
        "assignees": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "$ref": "#/$defs/assignee" } },
        "mode": { "enum": ["all", "any", "n-of-m"] },
        "forward": {
          "type": "object",
          "required": ["within"],
          "additionalProperties": false,
          "properties": { "within": { "enum": ["unit", "legalEntity", "anyone"] } }
        },
        "n": { "type": "integer", "minimum": 1, "maximum": 20 },
        "actions": { "type": "array", "uniqueItems": true, "maxItems": 9, "items": { "$ref": "#/$defs/action" } },
        "remarks": { "type": "array", "uniqueItems": true, "maxItems": 9, "items": { "$ref": "#/$defs/action" } },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "next"],
            "properties": {
              "when": { "type": "string", "minLength": 1, "maxLength": 1000 },
              "next": { "$ref": "#/$defs/target" }
            }
          }
        },
        "otherwise": { "$ref": "#/$defs/target" },
        "recipients": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/assignee" } },
        "message": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,59}$" },
        "definition": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,99}$" },
        "forum": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,99}$" },
        "sla": { "$ref": "#/$defs/sla" },
        "fallback": { "$ref": "#/$defs/assignee" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "route" } } },
          "then": { "required": ["next"], "propertyNames": { "enum": ["id", "type", "name", "next", "actions", "remarks", "sla", "forward"] } }
        },
        {
          "if": { "properties": { "type": { "enum": ["review", "approve", "sign"] } } },
          "then": { "required": ["assignee", "next"], "propertyNames": { "enum": ["id", "type", "name", "next", "assignee", "fallback", "actions", "remarks", "sla", "forward"] } }
        },
        {
          "if": { "properties": { "type": { "const": "parallel" } } },
          "then": {
            "required": ["assignees", "mode", "next"],
            "propertyNames": { "enum": ["id", "type", "name", "next", "assignees", "mode", "n", "actions", "remarks", "sla", "forward"] },
            "if": { "properties": { "mode": { "const": "n-of-m" } } },
            "then": { "required": ["n"] },
            "else": { "not": { "required": ["n"] } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "doa" } } },
          "then": { "required": ["next"], "propertyNames": { "enum": ["id", "type", "name", "next", "actions", "remarks", "sla", "forward"] } }
        },
        {
          "if": { "properties": { "type": { "const": "branch" } } },
          "then": { "required": ["branches", "otherwise"], "propertyNames": { "enum": ["id", "type", "name", "branches", "otherwise"] } }
        },
        {
          "if": { "properties": { "type": { "const": "notify" } } },
          "then": { "required": ["recipients", "message", "next"], "propertyNames": { "enum": ["id", "type", "name", "next", "recipients", "message"] } }
        },
        {
          "if": { "properties": { "type": { "const": "subworkflow" } } },
          "then": { "required": ["definition", "next"], "propertyNames": { "enum": ["id", "type", "name", "next", "definition"] } }
        },
        {
          "if": { "properties": { "type": { "const": "escalate-to-forum" } } },
          "then": { "required": ["forum", "next"], "propertyNames": { "enum": ["id", "type", "name", "next", "forum"] } }
        }
      ]
    }
  }
}
